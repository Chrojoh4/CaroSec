{
  "name": "caro-trial-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent CARO trial management architecture and executable domain foundation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node src/server.js",
    "dev:practice": "node src/practice-server.js",
    "test": "node --test tests/*.test.js",
    "demo": "node src/demo.js",
    "sample:trial": "node src/sample-scenario.js",
    "records:backup": "node scripts/records-backup.js",
    "rehearse:trial": "node src/trial-rehearsal.js",
    "export:sample": "node src/export-sample.js",
    "check:supabase": "node --env-file=.env.local src/check-supabase.js",
    "build": "node build.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
