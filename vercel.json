{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' https://rootupwvjwfterxhfwqx.supabase.co; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/judge-sheets.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,.venv/**,requirements-dev.txt,tests/**,fixtures/**,docs/**,data/**,output/**,tmp/**,.env*,.git/**,.codex/**,.agents/**,web/**,public/**,supabase/**}"
    },
    "api/dog-results.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,.venv/**,requirements-dev.txt,tests/**,fixtures/**,docs/**,data/**,output/**,tmp/**,.env*,.git/**,.codex/**,.agents/**,web/**,public/**,supabase/**}"
    },
    "api/entry-form.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,.venv/**,requirements-dev.txt,tests/**,fixtures/**,docs/**,data/**,output/**,tmp/**,.env*,.git/**,.codex/**,.agents/**,web/**,public/**,supabase/**}"
    },
    "api/online-entry.js": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,.venv/**,requirements-dev.txt,tests/**,fixtures/**,docs/**,data/**,output/**,tmp/**,.env*,.git/**,.codex/**,.agents/**,web/**,public/**,supabase/**}"
    },
    "api/entry-receipt.js": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,.venv/**,requirements-dev.txt,tests/**,fixtures/**,docs/**,data/**,output/**,tmp/**,.env*,.git/**,.codex/**,.agents/**,web/**,public/**,supabase/**}"
    },
    "api/entry-proof.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,.venv/**,requirements-dev.txt,tests/**,fixtures/**,docs/**,data/**,output/**,tmp/**,.env*,.git/**,.codex/**,.agents/**,web/**,public/**,supabase/**}"
    }
  }
}
